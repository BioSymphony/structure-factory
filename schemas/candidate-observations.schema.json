{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://biosymphony.org/schemas/candidate-observations.schema.json",
  "title": "Candidate Observations",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_sha256",
    "observations"
  ],
  "properties": {
    "schema_version": {
      "const": "structure-factory-candidate-observations-v1"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "candidate_id",
          "stage_id",
          "protocol_sha256",
          "status",
          "evidence"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "stage_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "protocol_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "completed",
              "failed",
              "missing",
              "pending",
              "scientifically_rejected",
              "upstream_excluded"
            ]
          },
          "evidence": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          },
          "rule_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "upstream_stage_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "scientifically_rejected"
                }
              }
            },
            "then": {
              "required": [
                "rule_id"
              ]
            },
            "else": {
              "properties": {
                "rule_id": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "upstream_excluded"
                }
              }
            },
            "then": {
              "required": [
                "upstream_stage_id"
              ]
            },
            "else": {
              "properties": {
                "upstream_stage_id": false
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "completed",
                    "scientifically_rejected"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
